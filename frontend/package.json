{
  "name": "makhzani-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "مخزني - واجهة نظام إدارة المخازن (static, no CDN)",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "css": "tailwindcss -i src/input.css -o public/css/app.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o public/css/app.css --watch",
    "build": "npm run vendor && npm run css",
    "dev": "npm run vendor && npm run css:watch"
  },
  "devDependencies": { "tailwindcss": "3.4.17" },
  "dependencies": {
    "@fontsource/tajawal": "5.1.0",
    "@fortawesome/fontawesome-free": "6.5.2",
    "alpinejs": "3.14.9",
    "chart.js": "4.4.4"
  }
}
